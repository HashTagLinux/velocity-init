#!/bin/sh
### BEGIN INIT INFO
# Provides:          keepalive
# Required-Start:    $remote_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Container smoke-test keepalive service
### END INIT INFO

case "$1" in
  start)
    echo "keepalive up — Ctrl-C to stop the container"
    while true; do
      sleep 60
    done
    ;;
  stop)
    ;;
esac
