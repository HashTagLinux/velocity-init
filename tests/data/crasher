#!/bin/sh
### BEGIN INIT INFO
# Provides:          crasher
# Required-Start:    $remote_fs $syslog
# Required-Stop:     
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Test service that crashes
### END INIT INFO

case "$1" in
  start)
    # Print a message, then sleep for 2 seconds and exit with error (crash)
    echo "crasher starting..."
    sleep 2
    exit 1
    ;;
  stop)
    echo "crasher stopping..."
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
exit 0
